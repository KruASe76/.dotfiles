#!/usr/bin/env bash
set -u

LOCAL_REPO="/mnt/ext4/kruasus_backup/"
REMOTE_REPO="kruase@mfhome:/mnt/storage/backups/kruasus/"

notify_backup() {
    pika-notify \
        "Backup ${OUTCOME,,} $([ -n "${RESULT_MSG:-}" ] && printf '%s' "- $RESULT_MSG")" \
        "Configuration: ${CONFIG_NAME:-unknown}"
}

notify_backup

# Pika backup завершился неуспешно — remote mirror не обновляем.
if [ "${OUTCOME:-}" != "SUCCESS" ]; then
    exit 0
fi

if flock -n "$HOME/.cache/pika-rsync.lock" \
    rsync -aH --delete --partial "$LOCAL_REPO" "$REMOTE_REPO"
then
    pika-notify \
        "Backup replication succeeded" \
        "Configuration: ${CONFIG_NAME:-unknown}"
else
    rc=$?

    pika-notify \
        "Backup replication failed - rsync exit code $rc" \
        "Configuration: ${CONFIG_NAME:-unknown}"

    exit "$rc"
fi
